@@ -329,13 +329,22 @@
 
 static struct gl_context gl_ctx;
 
+static bool gl_ctx_ready;
+
+// RL Sideswipe NX: the console compiles thousands of shaders in one process. Build the context and
+// Mesa's GLSL built-in function library once and keep them; releasing them after every shader (as
+// the command-line tool does) made each compile regenerate the whole built-in library.
 void glsl_frontend_init()
 {
+	if (gl_ctx_ready)
+		return;
 	initialize_context(&gl_ctx, API_OPENGL_CORE);
+	gl_ctx_ready = true;
 }
 
 void glsl_frontend_exit()
 {
+	return;
 	_mesa_glsl_release_types();
 	_mesa_glsl_release_builtin_functions();
 }
